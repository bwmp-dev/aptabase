<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MultiShock</RootNamespace>
    <AssemblyName>Aptabase.Isolated.MultiShockProbe</AssemblyName>
    <ApplicationTitle>Aptabase isolated MAUI probe</ApplicationTitle>
    <ApplicationId>dev.aptabase.isolated.multishockprobe</ApplicationId>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <ApplicationManifest>Platforms/Windows/app.manifest</ApplicationManifest>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <PublishTrimmed>false</PublishTrimmed>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.11" />
    <PackageReference Include="Sentry.Maui" Version="6.8.0" />
  </ItemGroup>
</Project>
