namespace MultiShock;
public partial class App : Application
{
    public App() => InitializeComponent();
    protected override Window CreateWindow(IActivationState? activationState)
    {
        ProbeIsolation.DemandLaunchPermission();
        var window = new Window(new ContentPage()) { Title = "Isolated MAUI test - not MultiShock" };
        window.Created += (_, _) => RuntimeProbe.Start(window);
        return window;
    }
}
